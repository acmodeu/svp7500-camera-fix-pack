#!/bin/bash
# qrca-wrapper: on-demand PipeWire-to-V4L2 loopback feeder with hardware device isolation
#
# Launches GStreamer pipeline to feed PipeWire camera to /dev/video50,
# uses bwrap to hide raw IPU7 ISYS devices (/dev/video0..31),
# and automatically terminates GStreamer when qrca exits.

REAL_QRCA="/usr/bin/qrca"

if [ ! -x "$REAL_QRCA" ]; then
    echo "Error: $REAL_QRCA not found" >&2
    exit 1
fi

# Ensure /dev/video50 exists
if [ ! -e /dev/video50 ]; then
    echo "Warning: /dev/video50 does not exist (v4l2loopback not loaded?)" >&2
    exec "$REAL_QRCA" "$@"
fi

# Start GStreamer to feed /dev/video50 with processed camera stream
gst-launch-1.0 -q \
    pipewiresrc target-object="libcamera_input.__SB_.LNK1" ! \
    videoconvert ! \
    videobalance saturation=1.35 contrast=1.05 ! \
    "video/x-raw,format=YUY2,width=1280,height=720,framerate=30/1" ! \
    v4l2sink device=/dev/video50 sync=false >/dev/null 2>&1 &
GST_PID=$!

# Guarantee cleanup of GStreamer when qrca exits
cleanup() {
    if [ -n "$GST_PID" ]; then
        kill "$GST_PID" 2>/dev/null
        wait "$GST_PID" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM HUP

# Wait for /dev/video50 to be negotiated (typically ~0.5s)
for i in {1..30}; do
    if v4l2-ctl -d /dev/video50 --list-formats 2>/dev/null | grep -q "YUYV"; then
        break
    fi
    sleep 0.05
done

# Build bwrap flags to mask raw IPU7 ISYS devices (/dev/video0..31)
# so QtMultimedia only sees /dev/video50 ("Integrated Camera")
if command -v bwrap >/dev/null 2>&1; then
    BWRAP_ARGS=(
        --bind / /
        --dev-bind /dev /dev
    )
    for i in $(seq 0 31); do
        if [ -e "/dev/video$i" ]; then
            BWRAP_ARGS+=(--bind /dev/null "/dev/video$i")
        fi
    done
    bwrap "${BWRAP_ARGS[@]}" "$REAL_QRCA" "$@"
else
    "$REAL_QRCA" "$@"
fi
